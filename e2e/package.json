{
  "name": "@splitcortex/e2e",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.19.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "dev": "node scripts/dev.mjs",
    "test": "playwright test",
    "test:platform": "playwright test --project=platform",
    "test:web-node": "playwright test --project=web-node",
    "test:cli": "playwright test --project=cli",
    "test:api": "playwright test --project=api",
    "test:serving": "playwright test --project=serving",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:perf": "E2E_PERF=1 playwright test --project=perf",
    "gen:proto": "scripts/gen-proto.sh"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "webdriverio": "^10.2.0"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@cipherman/pake-js": "^0.1.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  }
}
