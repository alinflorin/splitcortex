# Copy to .env (git-ignored). In CI these come from GitHub secrets/variables instead.
# The web app of the environment under test (no trailing slash); default https://local.splitcortex.com.
# Dex and the web node are derived from it: https://dex.<host> and https://web-node.<host>.
BASE_URL=

# Comma separated, same order and length.
E2E_EMAILS=
E2E_PASSWORDS=

# Optional: node release versions to test (X.Y.Z); empty = the rolling cli-node-latest / mobile-node-latest.
E2E_CLI_VERSION=
E2E_MOBILE_VERSION=

# Optional: only these node types get pools (web,cli,android; `none` for no devices); empty = all. Workers: E2E_WORKERS (default 4).
E2E_NODE_TYPES=
E2E_WORKERS=

# Opt in: tests the per-IP limit on /enroll/* (blocks other enrollments from this IP for a minute)
E2E_RATE_LIMIT=
