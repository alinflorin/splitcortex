# Development image for Tilt: runs the Vite dev server (HMR) on 8080 so the chart's Service/Ingress/probes
# work unchanged. Source changes are synced in by Tilt live_update; only package.json/lockfile changes rebuild.
# Build context: src/ui
FROM node:26-slim
RUN npm install -g pnpm@12.19.0
RUN mkdir /app && chown 1000:1000 /app
WORKDIR /app
USER 1000:1000
COPY --chown=1000:1000 package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY --chown=1000:1000 . .
EXPOSE 8080
CMD ["pnpm", "dev", "--host", "0.0.0.0", "--port", "8080", "--strictPort"]
