{
	admin off
	auto_https off
}

# TLS is terminated by the ingress (Traefik); this only serves the static SPA.
:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Hashed build assets never change.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Translations and the shell must be revalidated.
	@dynamic path / /index.html /locales/*
	header @dynamic Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# SPA fallback for client-side routes (BrowserRouter).
	try_files {path} /index.html
	file_server
}
