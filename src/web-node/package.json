{
  "name": "@splitcortex/web-node",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write src index.html --ignore-path ../../.prettierignore",
    "format:check": "prettier --check src index.html --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml",
    "test:watch": "vitest",
    "gen:proto": "scripts/gen-proto.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.17.0",
    "@cipherman/pake-js": "^0.1.1",
    "@fluentui/react-components": "^9.75.2",
    "@fluentui/react-icons": "^2.0.345",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^7.0.7",
    "@litert-lm/core": "^0.19.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.1",
    "i18next-http-backend": "^4.0.10",
    "jsqr": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "oxc-transform-react": "^0.158.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.19.0"
}
