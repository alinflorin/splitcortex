{
	admin off
	auto_https off
}

# TLS is terminated by the ingress (Traefik); this only serves the static SPA.
:8080 {
	root * /srv
	# Brotli comes precompressed from the image (file_server below); other encodings are done on the fly.
	encode zstd gzip

	# The web node is an app, not a page to find: never indexed.
	header X-Robots-Tag "noindex, nofollow, noarchive"
	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond `User-agent: *
Disallow: /
` 200
	}

	# Runtime settings for the app: the Google Analytics measurement id (GA_MEASUREMENT_ID, only in production; empty = none).
	handle /config.json {
		header Content-Type application/json
		header Cache-Control no-cache
		respond `{"analyticsId":"{$GA_MEASUREMENT_ID:}"}` 200
	}

	handle /healthz {
		respond "ok" 200
	}

	# The Helm chart version (APP_VERSION is set by the chart's Deployment); shown in the app.
	handle /version.json {
		header Content-Type application/json
		header Cache-Control no-cache
		respond `{"version":"{$APP_VERSION:dev}"}` 200
	}

	# Hashed build assets never change.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The LiteRT-LM WASM runtime is not content-hashed (the glue .js and the .wasm must always match): revalidate.
	@litert path /litertlm/*
	header @litert Cache-Control "no-cache"

	# Translations and the shell must be revalidated.
	@dynamic path / /index.html /locales/*
	header @dynamic Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	# SPA fallback for client-side routes (BrowserRouter). In a handle of its own: a bare try_files runs before the
	# handle blocks above and would rewrite /healthz and /version.json to the index page.
	handle {
		try_files {path} /index.html
		file_server {
			precompressed br
		}
	}
}
