# Development image for Tilt: runs `tsx watch` on 8080 (same port as production, so the chart's Service, Ingress
# and probes work unchanged). Source changes are synced in by Tilt live_update; only dependency changes rebuild.
# The migration Job uses this same image (see the Tiltfile).
# Build context: src/control-plane
FROM node:26-slim
RUN npm install -g pnpm@12.19.0
RUN mkdir /app && chown 1000:1000 /app
WORKDIR /app
USER 1000:1000
COPY --chown=1000:1000 package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY --chown=1000:1000 . .
EXPOSE 8080
CMD ["pnpm", "dev"]
